{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft NATS contract profile",
  "description": "Structural schema for the x-nats-contract value in an AsyncAPI document. It does not validate the surrounding AsyncAPI document, resolve references, establish subject or interaction semantics, validate native NATS configuration, or prove runtime behavior.",
  "type": "object",
  "required": ["version", "tokenTypes", "channels", "operations"],
  "properties": {
    "version": {
      "const": "0.1.0-draft"
    },
    "tokenTypes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/tokenType"
      }
    },
    "channels": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/channel"
      }
    },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/operation"
      }
    },
    "streams": {
      "type": "object",
      "minProperties": 0,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/nativeConfig"
      }
    },
    "consumers": {
      "type": "object",
      "minProperties": 0,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/consumer"
      }
    },
    "adapters": {
      "type": "object",
      "minProperties": 0,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/adapter"
      }
    },
    "interactions": {
      "type": "object",
      "minProperties": 0,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/interaction"
      }
    },
    "pipelines": {
      "type": "object",
      "minProperties": 0,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/pipeline"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "runtimeExpression": {
      "type": "string",
      "pattern": "^\\$message\\.(payload|header)#/"
    },
    "tokenType": {
      "type": "object",
      "required": ["pattern"],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "stringMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "channel": {
      "type": "object",
      "required": ["parameters"],
      "properties": {
        "parameters": {
          "$ref": "#/$defs/stringMap"
        },
        "filters": {
          "$ref": "#/$defs/stringMap"
        }
      },
      "additionalProperties": false
    },
    "corePublish": {
      "type": "object",
      "required": ["api", "confirmation"],
      "properties": {
        "api": {
          "const": "core"
        },
        "confirmation": {
          "const": "none"
        }
      },
      "additionalProperties": false
    },
    "jetstreamPublish": {
      "type": "object",
      "required": ["api", "confirmation", "stream"],
      "properties": {
        "api": {
          "const": "jetstream"
        },
        "confirmation": {
          "const": "stream-ack"
        },
        "stream": {
          "$ref": "#/$defs/identifier"
        }
      },
      "additionalProperties": false
    },
    "publish": {
      "oneOf": [
        {
          "$ref": "#/$defs/corePublish"
        },
        {
          "$ref": "#/$defs/jetstreamPublish"
        }
      ]
    },
    "coreSubscribe": {
      "type": "object",
      "required": ["api"],
      "properties": {
        "api": {
          "const": "core"
        }
      },
      "additionalProperties": false
    },
    "jetstreamSubscribe": {
      "type": "object",
      "required": ["api", "consumer"],
      "properties": {
        "api": {
          "const": "jetstream"
        },
        "consumer": {
          "$ref": "#/$defs/identifier"
        }
      },
      "additionalProperties": false
    },
    "subscribe": {
      "oneOf": [
        {
          "$ref": "#/$defs/coreSubscribe"
        },
        {
          "$ref": "#/$defs/jetstreamSubscribe"
        }
      ]
    },
    "requestReply": {
      "type": "object",
      "required": ["routing", "completion", "timeoutMs"],
      "properties": {
        "routing": {
          "const": "native-inbox"
        },
        "completion": {
          "const": "first-response"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "properties": {
        "publish": {
          "$ref": "#/$defs/publish"
        },
        "subscribe": {
          "$ref": "#/$defs/subscribe"
        },
        "requestReply": {
          "$ref": "#/$defs/requestReply"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["publish"]
        },
        {
          "required": ["subscribe"]
        }
      ],
      "dependentRequired": {
        "requestReply": ["publish"]
      },
      "allOf": [
        {
          "if": {
            "required": ["requestReply"]
          },
          "then": {
            "properties": {
              "publish": {
                "$ref": "#/$defs/corePublish"
              }
            }
          }
        }
      ]
    },
    "nativeConfig": {
      "type": "object",
      "description": "Opaque native NATS configuration. Validate against the applicable server configuration schema separately.",
      "additionalProperties": true
    },
    "consumer": {
      "type": "object",
      "required": ["stream", "config"],
      "properties": {
        "stream": {
          "$ref": "#/$defs/identifier"
        },
        "config": {
          "$ref": "#/$defs/nativeConfig"
        }
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "required": ["kind", "version", "inputSchema", "outputSchema", "description"],
      "properties": {
        "kind": {
          "enum": [
            "audience",
            "authorization",
            "result-verifier",
            "aggregation",
            "transform",
            "selection",
            "delivery",
            "ownership"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "inputSchema": {
          "type": "string",
          "minLength": 1
        },
        "outputSchema": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "required": ["tokenType", "source"],
          "properties": {
            "tokenType": {
              "$ref": "#/$defs/identifier"
            },
            "source": {
              "enum": ["argument", "generated"]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["schema", "source"],
          "properties": {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "enum": ["argument", "generated"]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "audience": {
      "type": "object",
      "required": [
        "kind",
        "input",
        "scopeInput",
        "resolver",
        "authorization",
        "membership",
        "includeSender",
        "offline",
        "lateJoiners",
        "onRevocation"
      ],
      "properties": {
        "kind": {
          "enum": ["peer", "group", "scope"]
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "scopeInput": {
          "type": "string",
          "minLength": 1
        },
        "resolver": {
          "$ref": "#/$defs/identifier"
        },
        "authorization": {
          "$ref": "#/$defs/identifier"
        },
        "membership": {
          "const": "snapshot-at-admission"
        },
        "includeSender": {
          "type": "boolean"
        },
        "offline": {
          "enum": ["include", "exclude"]
        },
        "lateJoiners": {
          "const": "exclude"
        },
        "onRevocation": {
          "const": "cancel-open-branches"
        }
      },
      "additionalProperties": false
    },
    "dispatch": {
      "type": "object",
      "required": ["mode", "branchKey"],
      "properties": {
        "mode": {
          "enum": ["none", "direct", "independent", "one-eligible", "branches"]
        },
        "branchKey": {
          "enum": ["recipient", "declared"]
        },
        "targetParameter": {
          "type": "string",
          "minLength": 1
        },
        "branchesInput": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "$ref": "#/$defs/identifier"
        }
      },
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "required": ["mode", "state", "restart", "maxAttempts"],
      "properties": {
        "mode": {
          "enum": ["online-best-effort", "durable-per-recipient"]
        },
        "state": {
          "enum": ["memory", "durable"]
        },
        "restart": {
          "enum": ["fail-unknown", "resume"]
        },
        "maxAttempts": {
          "const": 1,
          "description": "Retry scheduling is outside this draft; execution permits one attempt per branch."
        },
        "adapter": {
          "$ref": "#/$defs/identifier"
        },
        "ownership": {
          "$ref": "#/$defs/identifier"
        }
      },
      "additionalProperties": false
    },
    "correlation": {
      "type": "object",
      "required": ["operation", "branch", "attempt", "peer"],
      "properties": {
        "operation": {
          "$ref": "#/$defs/runtimeExpression"
        },
        "branch": {
          "$ref": "#/$defs/runtimeExpression"
        },
        "attempt": {
          "$ref": "#/$defs/runtimeExpression"
        },
        "peer": {
          "$ref": "#/$defs/runtimeExpression"
        },
        "verifier": {
          "$ref": "#/$defs/identifier"
        }
      },
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "required": ["field", "equals"],
      "properties": {
        "field": {
          "$ref": "#/$defs/runtimeExpression"
        },
        "equals": {
          "type": ["string", "number", "boolean", "null"]
        }
      },
      "additionalProperties": false
    },
    "noCompletion": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "const": "none"
        }
      },
      "additionalProperties": false
    },
    "resultCompletion": {
      "type": "object",
      "required": ["mode", "unit", "success", "deadlineMs", "onTimeout", "onImpossible", "lateResults", "remaining"],
      "properties": {
        "mode": {
          "enum": ["first-success", "all-terminal", "all-successful", "quorum"]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "enum": ["distinct-branches", "distinct-peers"]
        },
        "success": {
          "$ref": "#/$defs/success"
        },
        "deadlineMs": {
          "type": "integer",
          "minimum": 1
        },
        "onTimeout": {
          "enum": ["fail", "partial"]
        },
        "onImpossible": {
          "const": "fail"
        },
        "lateResults": {
          "const": "discard"
        },
        "remaining": {
          "enum": ["detach", "cooperative"]
        },
        "cancelOperation": {
          "$ref": "#/$defs/identifier"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "quorum"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "required": ["count"]
          },
          "else": {
            "not": {
              "required": ["count"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "remaining": {
                "const": "cooperative"
              }
            },
            "required": ["remaining"]
          },
          "then": {
            "required": ["cancelOperation"]
          },
          "else": {
            "not": {
              "required": ["cancelOperation"]
            }
          }
        }
      ]
    },
    "completion": {
      "oneOf": [
        {
          "$ref": "#/$defs/noCompletion"
        },
        {
          "$ref": "#/$defs/resultCompletion"
        }
      ]
    },
    "interaction": {
      "type": "object",
      "required": ["inputs", "audience", "dispatch", "delivery", "correlation", "completion"],
      "properties": {
        "requestOperation": {
          "$ref": "#/$defs/identifier"
        },
        "resultOperation": {
          "$ref": "#/$defs/identifier"
        },
        "inputs": {
          "type": "object",
          "minProperties": 0,
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/input"
          }
        },
        "audience": {
          "$ref": "#/$defs/audience"
        },
        "dispatch": {
          "$ref": "#/$defs/dispatch"
        },
        "delivery": {
          "$ref": "#/$defs/delivery"
        },
        "correlation": {
          "$ref": "#/$defs/correlation"
        },
        "completion": {
          "$ref": "#/$defs/completion"
        },
        "aggregation": {
          "$ref": "#/$defs/identifier"
        }
      },
      "additionalProperties": false
    },
    "pipelineStep": {
      "oneOf": [
        {
          "type": "object",
          "required": ["interaction"],
          "properties": {
            "interaction": {
              "$ref": "#/$defs/identifier"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation"],
          "properties": {
            "operation": {
              "$ref": "#/$defs/identifier"
            },
            "inputAdapter": {
              "$ref": "#/$defs/identifier"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "pipeline": {
      "type": "object",
      "required": ["steps", "onFailure"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pipelineStep"
          }
        },
        "onFailure": {
          "const": "stop"
        }
      },
      "additionalProperties": false
    }
  }
}
