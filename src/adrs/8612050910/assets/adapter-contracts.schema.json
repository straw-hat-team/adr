        },
        "jetstreamDomain": {
          "$ref": "#/definitions/Identifier"
        }
      },
      "required": [
        "contractId",
        "contractVersion",
        "contractDigest",
        "operationId",
        "principalId",
        "invocationKey",
        "inputDigest",
        "input",
        "phase",
        "snapshot",
        "policyRevision",
        "branches",
        "decision",
        "settlement",
        "outbox",
        "senderPeerId",
        "scopeId",
        "systemId",
        "accountId",
        "jetstreamDomain"
      ],
      "additionalProperties": false,
      "description": "Creation input before admission timestamps exist. Provider stamps admittedAtMs and deadlineMs at the guarded serialization point and returns the complete authoritative OperationRecord."
    }
