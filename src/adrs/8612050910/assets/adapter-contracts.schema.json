          "$ref": "#/definitions/SafeInteger"
        }
      },
      "required": ["operationId", "branchId", "peerId", "attempt", "fence", "reason", "cancelDeadlineMs"],
      "additionalProperties": false
    },
    "CancelResult": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "#/definitions/OperationId"
        },
        "branchId": {
          "$ref": "#/definitions/Identifier"
        },
        "peerId": {
          "$ref": "#/definitions/Identifier"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "fence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": ["stopped", "already-completed", "unknown"]
        }
      },
      "required": ["operationId", "branchId", "peerId", "attempt", "fence", "status"],
