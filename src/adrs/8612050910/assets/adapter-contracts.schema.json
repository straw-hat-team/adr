    },
    "TimeGuard": {
      "type": "object",
      "properties": {
        "notBeforeMs": {
          "$ref": "#/definitions/SafeInteger"
        },
        "notAfterMs": {
          "$ref": "#/definitions/SafeInteger"
        }
      },
      "required": ["notBeforeMs", "notAfterMs"],
      "additionalProperties": false,
      "description": "Provider-side interval notBeforeMs <= serialized decision time < notAfterMs. The same decision time is returned as committedAtMs on mutation. Empty/reversed intervals are semantic errors."
    },
    "AdapterError": {
      "type": "object",
